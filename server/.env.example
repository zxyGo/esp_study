# 默认连接宿主机 Ollama；先执行：ollama pull qwen2.5:3b
LLM_API_BASE=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# 也可改成任意 OpenAI Chat Completions 兼容服务，例如：
# LLM_API_BASE=https://your-provider.example/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-api-key

LLM_SYSTEM_PROMPT=你是运行在 ESP32 语音助手中的中文助理。回答自然、准确、简短，默认不超过80个汉字；只输出纯文本，不使用Markdown或表情。
LLM_MAX_TOKENS=160
LLM_TEMPERATURE=0.7
# 智谱 GLM-4.7-Flash 建议设为 disabled，避免短输出额度被思考过程耗尽；其他服务可留空。
LLM_THINKING=
LLM_HISTORY_TURNS=4
LLM_REQUEST_TIMEOUT=60

# 大模型回答使用本机 sherpa-onnx 离线合成，不产生 API 调用费用。
TTS_MODEL_DIR=/models/vits-melo-tts-zh_en
TTS_SPEED=1.0
TTS_NUM_THREADS=2
TTS_MAX_AUDIO_BYTES=4194304
TTS_TARGET_PEAK=0.25
